# Copie para .env e ajuste se necessário. Todos os valores são opcionais.

# Porta e endereço do servidor (0.0.0.0 = aceita acesso pela rede local)
PORT=3000
HOST=0.0.0.0

# Pastas do banco e dos backups (relativas à pasta do projeto ou caminhos absolutos)
DATA_DIR=data
BACKUP_DIR=backups
# Quantidade de backups mantidos
BACKUP_KEEP=30

# Use true quando o acesso for por HTTPS (ex.: Cloudflare Tunnel)
COOKIE_SECURE=false
# Use true quando houver proxy/túnel na frente do servidor (IP real do visitante)
TRUST_PROXY=false
# Endereço(s) público(s) do site, separados por vírgula, se o login externo falhar
# com "Origem da requisição não permitida". Ex.: https://bolao.seudominio.com.br
ALLOWED_ORIGINS=
